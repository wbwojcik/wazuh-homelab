# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored - NEVER commit it.

# Wazuh manager API, reached over WireGuard (your server's VPN address)
WAZUH_API_URL=https://10.10.0.1:55000

# Read-only API user (role: readonly). Keep the password in your password manager.
WAZUH_API_USER=claude-ro
WAZUH_API_PASSWORD=CHANGE_ME

# false = accept the self-signed lab certificate (traffic is still TLS inside WireGuard)
# true  = verify against system CAs, or put a path to a CA/cert file here
WAZUH_VERIFY_SSL=false

# Indexer (alerts + vulnerabilities), reached through the SSH tunnel - see docs/14-claude-mcp.md
# Leave INDEXER_USER empty to disable the alert/vulnerability tools.
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=claude-idx-ro
INDEXER_PASSWORD=CHANGE_ME
INDEXER_VERIFY_SSL=false

# Optional
# WAZUH_TIMEOUT=30
# WAZUH_MCP_LOG_LEVEL=INFO

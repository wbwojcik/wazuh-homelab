{
  "policy": {
    "description": "Delete weekly wazuh-monitoring-* / wazuh-statistics-* indices older than 8 weeks (dashboard stats only)",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [{ "state_name": "delete", "conditions": { "min_index_age": "56d" } }]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [{ "index_patterns": ["wazuh-monitoring-*", "wazuh-statistics-*"], "priority": 100 }]
  }
}
